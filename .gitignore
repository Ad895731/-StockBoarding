# ==============================================================================
# StockBoarding Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secret Files
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
!.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/venv/
backend/.venv/

# ------------------------------------------------------------------------------
# Backend Runtime Uploads & Generated Data
# (Excludes personal documents, statements, and user uploads)
# ------------------------------------------------------------------------------
uploads/
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# Flutter & Dart
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/build/
flutter_app/coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android Platform (Flutter)
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
.gradle/
local.properties

# Android Keystore & Private signing keys
key.properties
**/*.keystore
**/*.jks

# ------------------------------------------------------------------------------
# iOS & macOS Platforms (Flutter)
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/.symlinks/
*.moved-aside
*.ipa
*.app

# ------------------------------------------------------------------------------
# Operating System & Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__MACOSX/

# ------------------------------------------------------------------------------
# IDEs and Code Editors
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Sensitive certificates and keys
*.pem
*.key
*.crt
*.cert
*.p12
